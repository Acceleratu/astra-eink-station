(version 1)
# JLC rigid FR4 / two layers / 1 oz / ENIG, Standard top SMT.
(rule "JLC different-net surface lands"
  (condition "A.Pad_Type == 'SMD' && B.Pad_Type == 'SMD'")
  (constraint clearance (min 0.15mm)))
(rule "JLC PTH annular ring"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.18mm)))
(rule "JLC PTH drill to other copper"
  (condition "A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.28mm)))
(rule "JLC pad hole spacing"
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))
(rule "JLC NPTH drill minimum"
  (condition "A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_size (min 0.50mm)))
