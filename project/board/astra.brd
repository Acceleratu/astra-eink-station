      <designrules name="ASTRA_JLC_STD_2L_1MM_ENIG">
        <description language="en">2-layer FR4, finished 1 mm, 1 oz external copper, green LPI and ENIG; Standard PCBA. Regular vias 0.30 mm drill / 0.60 mm copper. See fabrication profile and independently opened CAM.</description>
        <rules>
          <rulecategory type="Stencil" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Solder Mask" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Annular Ring" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Teardrop" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Via Restrict Clearance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Matched Lengths" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Wire Stub" manualdrc="yes" livedrc="no" />
          <rulecategory type="Small Gap" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Air-Wire" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Acute Angle" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Minimum Copper Width" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Minimum Drill Size" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Restrict Clearance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Drill Distance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Dimension Clearance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Solder-Mask Clearance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Keepout Clearance" manualdrc="yes" livedrc="yes" />
          <rulecategory type="Copper Clearance" manualdrc="yes" livedrc="yes" />
          <rule type="Minimum Copper Width" enabled="yes" priority="0" value="0.25mm" preferredvalue="0.25mm" check_polywidth="no" name="Component solder lands (manufacturer patterns)" onescope="is_smd" />
          <rule type="Minimum Copper Width" enabled="yes" priority="1" value="0.30mm" preferredvalue="0.30mm" check_polywidth="no" name="Power conductors" onescope="class=1" />
          <rule type="Minimum Copper Width" enabled="yes" priority="2" value="0.15mm" preferredvalue="0.18mm" check_polywidth="no" name="General copper width" builtin_ruleid="14" />
          <rule type="Minimum Drill Size" builtin_ruleid="15" enabled="yes" priority="0" value="0.25mm" preferredvalue="0.25mm" name="minimum-drill-size-1" />
          <rule type="Stencil" builtin_ruleid="35" enabled="yes" priority="0" onescope="is_smd" parameter_type="calculated" absolute="0mil" percentage="0" minimum="0mil" maximum="0mil" auto_resize="yes" name="stencil-1" />
          <rule type="Wire Stub" builtin_ruleid="17" enabled="yes" priority="0" name="wire-stub-1" />
          <rule type="Acute Angle" builtin_ruleid="16" enabled="no" priority="0" name="acute-angle-1" />
          <rule type="Air-Wire" builtin_ruleid="19" enabled="yes" priority="0" name="air-wire-1" />
          <rule type="Matched Lengths" builtin_ruleid="20" enabled="yes" priority="0" tolerance="10mm" gapfactor="2.5" name="matched-lengths-1" />
          <rule type="Teardrop" builtin_ruleid="22" enabled="yes" priority="0" onescope="is_via" lengthratio="0.3" widthratio="0.7" curved_sides="no" auto_generate="no" omit_violators="yes" fit_to_space="no" name="teardrop-1" />
          <rule type="Teardrop" builtin_ruleid="23" enabled="yes" priority="1" onescope="is_pad" lengthratio="0.3" widthratio="0.7" curved_sides="no" auto_generate="no" omit_violators="yes" fit_to_space="no" name="teardrop-2" />
          <rule type="Teardrop" builtin_ruleid="24" enabled="yes" priority="2" onescope="is_smd" lengthratio="1" widthratio="2" curved_sides="no" auto_generate="no" omit_violators="yes" fit_to_space="no" name="teardrop-3" />
          <rule type="Teardrop" builtin_ruleid="25" enabled="yes" priority="3" onescope="is_wire_polygon" lengthratio="0.3" widthratio="0.7" curved_sides="no" auto_generate="no" omit_violators="yes" fit_to_space="no" name="teardrop-4" />
          <rule type="Annular Ring" builtin_ruleid="26" enabled="yes" priority="0" onescope="is_pad" rule_variant="top_pth_pad" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="0.2mm" maximum="0.5mm" auto_resize="yes" name="annular-ring-1" />
          <rule type="Annular Ring" builtin_ruleid="27" enabled="yes" priority="1" onescope="is_pad" rule_variant="bottom_pth_pad" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="0.2mm" maximum="0.5mm" auto_resize="yes" name="annular-ring-2" />
          <rule type="Annular Ring" builtin_ruleid="28" enabled="yes" priority="2" onescope="is_pad" rule_variant="inner_pth_pad" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="0.2mm" maximum="0.5mm" auto_resize="yes" match_outer="no" name="annular-ring-3" />
          <rule type="Annular Ring" builtin_ruleid="29" enabled="yes" priority="3" onescope="is_via" rule_variant="outer_via" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="0.125mm" maximum="0.3mm" auto_resize="yes" name="annular-ring-4" />
          <rule type="Annular Ring" builtin_ruleid="30" enabled="yes" priority="4" onescope="is_via" rule_variant="inner_via" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="0.125mm" maximum="0.3mm" auto_resize="yes" match_outer="no" name="annular-ring-5" />
          <rule type="Annular Ring" builtin_ruleid="31" enabled="yes" priority="5" onescope="is_via" rule_variant="outer_micro_via" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="4mil" maximum="15mil" auto_resize="yes" name="annular-ring-6" />
          <rule type="Annular Ring" builtin_ruleid="32" enabled="yes" priority="6" onescope="is_via" rule_variant="inner_micro_via" parameter_type="calculated" absolute="8mil" percentage="0.25" minimum="4mil" maximum="15mil" auto_resize="yes" match_outer="no" name="annular-ring-7" />
          <rule type="Annular Ring" builtin_ruleid="33" enabled="yes" priority="7" onescope="is_pad" rule_variant="non_functional_pad" remove_nf_pads="no" name="annular-ring-8" />
          <rule type="Solder Mask" builtin_ruleid="34" enabled="yes" priority="0" onescope="is_pad_via" parameter_type="calculated" absolute="4mil" percentage="1" minimum="0.025mm" maximum="0.025mm" auto_resize="yes" auto_tent="yes" tent_vias="0.35mm" name="solder-mask-1" />
          <rule type="Copper Clearance" builtin_ruleid="0" enabled="yes" priority="0" onescope="is_wire_polygon" otherscope="is_wire_polygon" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-1" />
          <rule type="Copper Clearance" builtin_ruleid="1" enabled="yes" priority="1" onescope="is_wire_polygon" otherscope="is_pad_smd" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-2" />
          <rule type="Copper Clearance" builtin_ruleid="2" enabled="yes" priority="2" onescope="is_wire_polygon" otherscope="is_via" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-3" />
          <rule type="Copper Clearance" builtin_ruleid="3" enabled="yes" priority="3" onescope="is_pad_smd" otherscope="is_pad_smd" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-4" />
          <rule type="Copper Clearance" builtin_ruleid="4" enabled="yes" priority="4" onescope="is_pad_smd" otherscope="is_via" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-5" />
          <rule type="Copper Clearance" builtin_ruleid="5" enabled="yes" priority="5" onescope="is_via" otherscope="is_via" value="0.15mm" preferredvalue="0.15mm" samesignal="no" name="copper-clearance-6" />
          <rule type="Copper Clearance" builtin_ruleid="6" enabled="yes" priority="6" onescope="is_smd" otherscope="is_pad" value="0.15mm" preferredvalue="0.15mm" samesignal="yes" name="copper-clearance-7" />
          <rule type="Copper Clearance" builtin_ruleid="7" enabled="yes" priority="7" onescope="is_smd" otherscope="is_via" value="0.15mm" preferredvalue="0.15mm" samesignal="yes" name="copper-clearance-8" />
          <rule type="Copper Clearance" builtin_ruleid="8" enabled="yes" priority="8" onescope="is_smd" otherscope="is_smd" value="0.15mm" preferredvalue="0.15mm" samesignal="yes" name="copper-clearance-9" />
          <rule type="Restrict Clearance" builtin_ruleid="10" enabled="yes" priority="0" value="0mil" preferredvalue="0mil" name="restrict-clearance-1" />
          <rule type="Dimension Clearance" builtin_ruleid="9" enabled="yes" priority="0" value="0.35mm" preferredvalue="0.35mm" name="dimension-clearance-1" />
          <rule type="Solder-Mask Clearance" builtin_ruleid="11" enabled="no" priority="0" value="0mil" preferredvalue="0mil" check_name="yes" check_value="no" name="solder-mask-clearance-1" />
          <rule type="Via Restrict Clearance" builtin_ruleid="21" enabled="yes" priority="0" value="0mil" preferredvalue="0mil" name="via-restrict-clearance-1" />
          <rule type="Drill Distance" builtin_ruleid="12" enabled="yes" priority="0" value="0.25mm" preferredvalue="0.25mm" name="drill-distance-1" />
          <rule type="Keepout Clearance" builtin_ruleid="13" enabled="yes" priority="0" value="0mil" preferredvalue="0mil" name="keepout-clearance-1" />
          <rule type="Small Gap" builtin_ruleid="18" enabled="yes" priority="0" name="small-gap-1" />
        </rules>
